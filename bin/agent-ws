#!/usr/bin/env python3
"""Agent workspaces: Hyprland workspaces as the Claude Code harness.

  agent-ws name set [NAME]   name the workspace; without NAME, prompt (Enter = accept the suggested slug)
  agent-ws name clear        remove the focused workspace's name (and forget its sessions)
  agent-ws name apply        push stored names into Hyprland (login)
  agent-ws launch            Super+Shift+A: resume the workspace's remembered sessions, else fresh
  agent-ws reset [--all]     put the workspace back to a bare number: no name, nothing remembered
  agent-ws slug TITLE        print the short label for a session title (heuristic, then cached AI)
  agent-ws hook EVENT [--agent NAME]
                             agent hook entry point; EVENT is any name Claude, Codex or
                             Muse fires (SessionStart, session_start, session-start …).
                             --agent is the agent whose config carries this hook line and
                             settles who fired it; without it we ask the process tree.
  agent-ws state             dump state (debug)

Config  ~/.config/omarchy/workspace-names.json   {"2": "rss-digest"}   workspace id -> its name
State   ~/.local/state/omarchy/agent-workspaces/  sessions.json · needs.json · slugs.json
"""
import contextlib, fcntl, json, os, re, subprocess, sys, time, hashlib

HOME = os.path.expanduser("~")
CONFIG = f"{HOME}/.config/omarchy/workspace-names.json"
STATE = os.environ.get("XDG_STATE_HOME", f"{HOME}/.local/state") + "/omarchy/agent-workspaces"
SESSIONS, NEEDS, SLUGS = (f"{STATE}/{n}.json" for n in ("sessions", "needs", "slugs"))
GLYPHS = "◐◑◒◓✳"
NEEDS_TYPES = ("permission_prompt", "agent_needs_input", "elicitation")  # idle_prompt is just idle
NEEDS_TTL = 3600      # Hyprland reuses window addresses, so a flag must not outlive its window
SLUG_CAP = 2000       # one entry per session title ever seen; bounded so the file cannot grow forever
LOG_CAP = 262144

# ---------- agents ----------
# One row per supported agent: how to recognise its process, which of its runs own no
# window, which payload keys carry what, and how it says "I need you" and "I am done".
# Everything below reads off this table, so a fourth agent is one more row here.
#
# The keys and the event names are what the binaries actually contain, not what any doc
# says: `strings` on the codex and muse-bin binaries, and their --help for the subcommands.

def canon(s):
    """One spelling for one event: SessionStart, session_start, session-start and
    pre-tool-use / PreToolUse / pre_tool_use all collapse. Used only after the exact
    table has missed, so a native name nobody listed verbatim still lands somewhere."""
    return re.sub(r"[^a-z0-9]", "", str(s).lower())

def needs_by_type(event, data):
    """Claude names the kind of notification in notification_type."""
    return str(data.get("notification_type", "")).startswith(NEEDS_TYPES)

def needs_by_event(event, data):
    """Codex and Muse have no Notification event at all: PermissionRequest is the whole
    signal, and it carries no notification_type, so the name is all there is to read.

    Both spellings count. The line the installer writes carries our own short name for the
    event; a hand-wired line carries the agent's. They mean the same thing, and nothing
    else reaches this branch for either agent, so reading only one of them meant the flag
    was never raised for a session that was in fact waiting on the user."""
    return canon(event) in ("permissionrequest", "notification")


def exit_by_reason(event, data):
    """Claude's /exit, as against a window that merely closed."""
    return data.get("reason") == "prompt_input_exit"

def never_exits(event, data):
    """Neither binary contains `prompt_input_exit`, and the SessionEnd reason we saw on
    the wire is a bare "other": nothing tells a deliberate exit from a closed window.
    Keeping the session is the safe way to be wrong — it stays resumable."""
    return False

# Straight from each binary's own --help, 2026-09-06: every flag it documents as taking a
# value. Everything else is a switch and does not swallow the token behind it.
CLAUDE_VALUED = frozenset((
    "--add-dir", "--agent", "--agents", "--allowed-tools", "--append-system-prompt",
    "--autocompact", "--betas", "--debug-file", "--disallowed-tools", "--effort",
    "--environment", "--fallback-model", "--file", "--input-format", "--json-schema",
    "--max-budget-usd", "--mcp-config", "--model", "-n", "--name", "--output-format",
    "--permission-mode", "--permission-prompts", "--plugin-dir", "--plugin-url",
    "--remote-control-session-name-prefix", "--resume", "--session-id", "--settings",
    "--setting-sources", "--system-prompt", "--system-prompt-snapshot", "--tools"))
CODEX_VALUED = frozenset((
    "-a", "--add-dir", "--ask-for-approval", "-c", "-C", "--cd", "--config", "--disable",
    "--enable", "-i", "--image", "--local-provider", "-m", "--model", "-p", "--profile",
    "--remote", "--remote-auth-token-env", "-s", "--sandbox"))
MUSE_VALUED = frozenset((
    "--agents", "--approval-judge", "--approval-mode", "--base-url", "--echo-delay-ms",
    "--image", "--model", "--permission-profile", "--preset", "--provider",
    "--reasoning-effort", "--sandbox-network", "--workspace", "--worktree-base",
    "--worktree-existing"))

# One row per supported agent.
#   procs        whole process basenames; a trailing * is the only prefix allowed, so
#                `museum` and `codex-notify.sh` are not agents
#   flags        headless switches, matched anywhere in argv (they are order-free)
#   valued       the flags this binary's own --help shows taking a value, so they and only
#                they swallow the token after them; anything else is a switch
#   subcommands  headless subcommands; a token that is one of these is a subcommand
#                unless it sits where a flag's value goes (see headless())
#   sid/cwd/transcript   payload keys, the ones seen on the wire first
#   cmd          how to start this agent fresh
#   resume       argv that reopens one of its sessions, () for an agent that cannot;
#                taken from each binary's own --help, not from a doc:
#                `claude --resume <id>` · `codex resume <SESSION_ID>` · `muse resume <session-uuid>`
AGENTS = (
    # Claude Code, the original agent: these keys are exactly what hook() always read.
    {"name": "claude",
     "procs": ("claude", "claude-code"),
     "flags": ("-p", "--print"),           # `claude -p` fires hooks but owns no window
     "subcommands": (),
     "valued": CLAUDE_VALUED,
     "sid": ("session_id",),
     "cwd": ("cwd",),
     "transcript": ("transcript_path",),
     "cmd": ("claude",), "resume": ("--resume", "{sid}"),
     "needs": needs_by_type, "exiting": exit_by_reason},
    # Codex. `-p` here is --profile and is windowed (`codex --help`); the headless runs
    # are subcommands. A captured SessionStart payload carries Claude's own key names;
    # the rest are accepted as a fallback but were never seen on the wire.
    {"name": "codex",
     "procs": ("codex",),
     "flags": (),
     "subcommands": ("exec", "e", "review"),
     "valued": CODEX_VALUED,
     "sid": ("session_id", "conversation_id", "conversationId", "sessionId"),
     "cwd": ("cwd", "working_directory", "workdir"),
     "transcript": ("transcript_path", "rollout_path"),
     "cmd": ("codex",), "resume": ("resume", "{sid}"),
     "needs": needs_by_event, "exiting": never_exits},
    # Muse Code: a wrapper script named `muse` that execs `muse-bin-<version>`, which is
    # the process the hook actually hangs under. Every key below was read off a payload
    # captured from a live Muse window, not from the binary: cwd, session_id, turn_id,
    # hook_event_name, model, permission_mode, and transcript_path, which is always null.
    # Its needs-you is PermissionRequest, the same as Codex: Muse fires no notification
    # event at all and sends no notification_type, so there is nothing else to read.
    {"name": "muse",
     "procs": ("muse", "muse-bin-*"),
     "flags": (),
     "subcommands": ("exec",),
     "valued": MUSE_VALUED,
     "sid": ("session_id",),
     "cwd": ("cwd",),
     "transcript": ("transcript_path",),
     "cmd": ("muse",), "resume": ("resume", "{sid}"),
     "needs": needs_by_event, "exiting": never_exits},
)
AGENT_ROWS = {a["name"]: a for a in AGENTS}
DEFAULT_AGENT = "claude"      # what an old record with no agent field was, and the fresh launch

# A payload field naming the agent. Third in line: `--agent` on the hook line settles it,
# then the process tree, and this only counts when the tree gives nothing either, which is
# pipes and tests, never a real hook firing. `source` is deliberately not here: both Codex
# and Muse send source="startup" on SessionStart.
AGENT_KEYS = ("agent", "agent_name", "agentName", "cli")

# Every native event name the three agents fire -> the internal event it means, and the
# agents that spell it that way, the likeliest first.
#   dashed short names  our own short spellings; five of them are what install writes
#   PascalCase          Claude Code's own vocabulary, which Codex and Muse both copied
#   snake_case          Codex's and Muse's config spellings, never Claude's
# Every name below is in one of the two binaries (`strings`) or in setup.py's HOOKS.
#
# The agent list is what the tree fallback is checked against: with no --agent we take the
# nearest agent above us and record nothing unless it spells this event. It is not used to
# choose between two agents in the tree — the nearest one is the one that fired the hook.
C, X, M = "claude", "codex", "muse"
EVENTS = {
    # the dashed names install writes into Claude's settings.json, all five of them;
    # Codex accepts the dashed spellings too
    "session-start": ("session-start", (C, X)),
    "session-end":   ("session-end",   (C, X)),
    "notification":  ("notification",  (C, M)),   # Codex has no notification event
    "prompt-submit": ("prompt-submit", (C,)),     # our own short name: Claude only
    "pre-tool":      ("pre-tool",      (C,)),     # our own short name: Claude only
    # install wires no stop hook at all — the five above are the whole set it writes.
    # This dashed spelling is here for a stop hook someone wires by hand; the codex
    # binary carries `stop` as well as `Stop`.
    "stop":          ("stop",          (C, X, M)),
    # the shared PascalCase vocabulary
    "SessionStart":      ("session-start", (X, M, C)),
    "SessionEnd":        ("session-end",   (X, M, C)),
    "Notification":      ("notification",  (M, C)),
    "UserPromptSubmit":  ("prompt-submit", (X, M, C)),
    "PreToolUse":        ("pre-tool",      (X, M, C)),
    "PostToolUse":       ("pre-tool",      (X, M, C)),   # a tool ran: still working
    "Stop":              ("stop",          (X, M, C)),
    "Interrupt":         ("stop",          (X,)),        # Esc mid-turn: Codex only
    "PreCompact":        ("pre-tool",      (X, M, C)),   # compaction happens mid-turn
    "PostCompact":       ("pre-tool",      (X, M)),
    "SubagentStart":     ("pre-tool",      (X, M)),
    "SubagentStop":      ("pre-tool",      (X, M, C)),   # the session works on after one stops
    "PermissionRequest": ("notification",  (X, M)),      # the needs-you signal for both
    # the snake_case spellings, which Claude never uses
    "session_start":       ("session-start", (M, X)),
    "session_end":         ("session-end",   (M, X)),
    "user_prompt_submit":  ("prompt-submit", (M, X)),
    "pre_tool_use":        ("pre-tool",      (M, X)),
    "post_tool_use":       ("pre-tool",      (M, X)),
    "permission_request":  ("notification",  (X, M)),
}
# The same table by collapsed spelling, unioning the agents of every spelling that
# collapses to it. A native name we did not list verbatim (Codex's `pre-tool-use`,
# `subagent_stop`, …) still lands on the right internal event instead of falling through.
CANON_EVENTS = {}
for _native, (_internal, _who) in EVENTS.items():
    _key = canon(_native)
    _prev = CANON_EVENTS.get(_key, (_internal, ()))[1]
    CANON_EVENTS[_key] = (_internal, tuple(dict.fromkeys(_prev + _who)))

def resolve_event(name):
    """(internal event, the agents that spell it this way), or None for a name we do not
    know. Exact first, then the collapsed spelling; only a genuinely foreign name misses."""
    return EVENTS.get(name) or CANON_EVENTS.get(canon(name))

# What each internal event says about the session: working, idle, or nothing.
STATE_OF = {"prompt-submit": "working", "pre-tool": "working", "stop": "idle"}

# The native events that only *continue* work: a tool call or a subagent finished. They
# keep a working session working, but they must never wake an idle one — a subagent's
# completion lands after its parent has already stopped often enough to matter, and the
# bar then shows a workspace working at nothing until the next prompt.
CONTINUES = {canon(n) for n in ("PostToolUse", "post_tool_use", "PostCompact", "SubagentStop")}

WALK = 40      # how far up the process tree every walk here looks, and they all agree

# ---------- small io ----------
class Corrupt(Exception):
    """The file is there but is not JSON. Never overwrite one of these."""

def load(path, default, strict=False):
    try:
        with open(path) as f: text = f.read()
    except OSError: return default
    if not text.strip(): return default      # nothing written yet: not a corrupt file
    try: return json.loads(text)
    except ValueError:
        if strict: raise Corrupt(path)
        return default

def save(path, data, sort=True):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"      # per-process: two writers must not share one
    with open(tmp, "w") as f: json.dump(data, f, indent=2, sort_keys=sort)
    os.replace(tmp, path)

def lock_path(path):
    """Locks live in the state dir so they never litter ~/.config, which is hand-edited."""
    return f"{STATE}/locks/{re.sub(r'[^A-Za-z0-9]+', '_', path)}.lock"

@contextlib.contextmanager
def locked(path):
    """Hold an exclusive lock on a state file across read-modify-write.

    Hooks fire on every tool call and Super+Shift+A starts every remembered session at
    once, so unsynchronised read-modify-write silently loses records."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lp = lock_path(path); os.makedirs(os.path.dirname(lp), exist_ok=True)
    with open(lp, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        yield

def update(path, fn, default=None):
    """Read, apply fn, write back, all under the file's lock. fn returns the new value."""
    with locked(path):
        cur = load(path, {} if default is None else default)
        new = fn(cur)
        if new is not None: save(path, new)
        return new

_HYPR_ENV = None

def hypr_env():
    """The environment hyprctl needs, found for ourselves when we were not given it.

    Muse and Codex run their hooks with a scrubbed environment - HOME, PATH, PWD, SHELL,
    TERM, USER and nothing else, measured from inside a live hook of each. Neither
    HYPRLAND_INSTANCE_SIGNATURE nor XDG_RUNTIME_DIR survives, so hyprctl has no socket to
    talk to and every such session would register with no window. Both are recoverable
    from the runtime directory: one directory per running compositor, newest first."""
    global _HYPR_ENV
    if _HYPR_ENV is not None: return _HYPR_ENV
    env = dict(os.environ)
    run = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if os.path.isdir(f"{run}/hypr"): env["XDG_RUNTIME_DIR"] = run
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            live = [(os.path.getmtime(f"{run}/hypr/{d}"), d) for d in os.listdir(f"{run}/hypr")
                    if os.path.exists(f"{run}/hypr/{d}/.socket.sock")]
        except OSError: live = []
        if live: env["HYPRLAND_INSTANCE_SIGNATURE"] = max(live)[1]
    _HYPR_ENV = env
    return env

def hypr(*args):
    out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True,
                         env=hypr_env()).stdout
    return json.loads(out) if out.strip() else None

def dispatch(lua):
    subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, env=hypr_env())

def clients():
    """Hyprland's windows, or None when we could not ask at all (no hyprctl, no compositor,
    a truncated answer). Never [] for "we do not know": every "is this window still there"
    below turns on that difference, and one failed call must not retire every session."""
    try: out = hypr("clients")
    except (OSError, ValueError): return None
    return out if isinstance(out, list) else None

def cmdline(pid):
    """argv of a pid, [] if it is gone. Split out so detection and headless share it."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except OSError: return []

def ppid(pid):
    """Parent of a pid; 1 when unreadable so callers just stop at init."""
    try:
        with open(f"/proc/{pid}/stat") as f: return int(f.read().split(")")[-1].split()[1])
    except (OSError, ValueError): return 1

def ancestry(pid=None):
    """This process' command line and its ancestors', nearest first, WALK deep. An
    ancestor whose command line we cannot read is skipped, not a wall: a kernel thread
    or a process we may not read must not hide the terminal above it."""
    pid = os.getppid() if pid is None else pid
    for _ in range(WALK):
        yield pid, cmdline(pid)
        pid = ppid(pid)
        if pid <= 1: return

def proc_is(base, pat):
    """A whole basename, unless the pattern ends in *, which is the only prefix we allow.
    `muse` must not match `museum` or `musescore`, and `codex` must not match
    `codex-notify.sh` — both of those were filing sessions against the wrong agent."""
    return base.startswith(pat[:-1]) if pat.endswith("*") else base == pat

def agent_for_argv(args):
    """(registry row, index of the token that named it) for this command line, or
    (None, -1). args[:2] because the binary may sit behind an interpreter, the way the
    old headless check always looked; the index is what tells a subcommand from a flag."""
    for i, a in enumerate(args[:2]):
        base = os.path.basename(a)
        for ag in AGENTS:
            if any(proc_is(base, p) for p in ag["procs"]): return ag, i
    return None, -1

def nearest_agent():
    """The nearest ancestor that is an agent of any kind, as (row, argv, index of the
    token that named it). Nearest, full stop: the agent a hook is running under is the
    agent that fired it. Walking past it to one that spells this event filed a Muse
    session against the Claude terminal it was started from."""
    for _pid, args in ancestry():
        ag, i = agent_for_argv(args)
        if ag is not None: return ag, args, i
    return None, [], -1

def tree_argv(row):
    """The nearest ancestor running this particular agent, as (argv, index), or ([], -1).
    Called when --agent has already settled who fired the hook: the command line is wanted
    only to tell a windowed run from a headless one."""
    for _pid, args in ancestry():
        ag, i = agent_for_argv(args)
        if ag is not None and ag["name"] == row["name"]: return args, i
    return [], -1

def agent_from_payload(data, spellers):
    """A payload field naming the agent, for a hook piped in by hand or by a test where
    there is no agent in the process tree at all. Every key is looked at, not just the
    first one present, and the answer still has to be an agent that spells this event."""
    for k in AGENT_KEYS:
        v = str(data.get(k, "")).lower()
        for name in spellers:
            if name in v: return AGENT_ROWS[name]
    return None

def normalize(data, row):
    """One internal shape from any agent's stdin JSON. A field the agent does not send
    stays empty: inventing a transcript would make launch try to resume nothing. Values
    are coerced to str, so a numeric session id cannot become a key that never matches
    the string one written next to it."""
    def first(keys):
        for k in keys:
            v = data.get(k)
            if v is None or isinstance(v, bool): continue   # Muse sends transcript_path: null
            s = str(v).strip()
            if s: return s
        return ""
    return {"sid": first(row["sid"]), "cwd": first(row["cwd"]),
            "transcript": first(row["transcript"])}

def is_helper(data):
    """A helper Muse runs inside a session fires the same events, under an id of its own.

    Measured on the wire: in one live run the events carried three session ids, the real
    one and two helpers, and in every helper case the session id was exactly the turn id
    while the real session's two always differed. One of the helper events asked for the
    user - taken at face value it would raise the hand on a session that owns no window,
    and could then clear the real one's."""
    sid, turn = data.get("session_id"), data.get("turn_id")
    return bool(sid) and sid == turn

def headless(row, args, i):
    """True for `claude -p` and the other agents' headless equivalents. Those fire the
    same hooks but own no window, so without this they get filed against whatever
    terminal happens to be up the process tree.

    A flag counts anywhere in argv, because flags are order-free. A subcommand counts
    anywhere after the binary *except* immediately after a flag, where it is that flag's
    value: `codex --profile exec` runs the profile named exec in a window, while
    `codex -m gpt-6-astra exec x` and `codex --config k=v exec x` are background runs that
    the old "first non-switch token wins" rule read as windowed. Which flags take a value
    is not knowable for three CLIs that keep moving, so position is all we go on; a flag
    that carries its own value (`-c k=v`, `--model=x`) does not eat the next token."""
    if any(a in row["flags"] for a in args): return True
    after_flag = False
    for a in args[i + 1:]:
        if a == "--": after_flag = False; continue          # everything after is positional
        if len(a) > 1 and a.startswith("-"):
            after_flag = "=" not in a and a in row["valued"]
            continue
        if not after_flag and a in row["subcommands"]: return True
        after_flag = False
    return False

def norm_addr(a):
    """Hyprland gives "0x55..." over hyprctl and bare over the event socket; store bare."""
    return str(a or "").removeprefix("0x").lower()

def notify(title, body=""):
    subprocess.run(["omarchy-notification-send", title, body], capture_output=True)

# ---------- names / config ----------
def config(): return load(CONFIG, {})

def ws_name(ws):
    """The name you gave a workspace, or "" if you never named it."""
    e = config().get(str(ws))
    return e.strip() if isinstance(e, str) else ""

def set_name(ws, name):
    """Never write over a config file we could not read: that would wipe every name."""
    with locked(CONFIG):
        try: c = load(CONFIG, {}, strict=True)
        except Corrupt:
            notify("Workspace names not saved",
                   "~/.config/omarchy/workspace-names.json is not valid JSON. Fix it first.")
            return False
        if name: c[str(ws)] = name
        else: c.pop(str(ws), None)
        save(CONFIG, c)
    return True

# ---------- windows ----------
def focused_ws(): return hypr("activeworkspace")["id"]

def window_for_process(pid=None):
    """Walk up the process tree until a pid owns a Hyprland window. Same walk, same
    depth and same tolerance of an unreadable ancestor as every other walk here."""
    by_pid = {c["pid"]: c for c in (clients() or [])}
    for p, _args in ancestry(pid or os.getpid()):
        if p in by_pid: return by_pid[p]
    return None

def owns_window(rec, win):
    """Is this window the one that session is running in? Hyprland hands a closed window's
    address straight to the next window, so the pid has to agree too where we recorded one."""
    if norm_addr(rec.get("address", "")) != norm_addr(win.get("address")): return False
    return not rec.get("pid") or rec["pid"] == win.get("pid")

def session_windows(ws=None):
    """The windows holding a session, optionally in one workspace.

    A session record pointing at the window is the test. Codex and Muse title their windows
    however they like, so requiring Claude's status glyph meant a workspace full of Codex
    sessions looked empty. The glyph stays as a second way in, because Claude paints it
    before our own session-start hook has written anything — and it is Claude's *state*,
    not the proof a session exists."""
    open_recs = [r for r in sessions().values() if r.get("open") and r.get("address")]
    out = []
    for c in (clients() or []):
        if ws is not None and c["workspace"]["id"] != ws: continue
        t = c.get("title") or ""
        # `"" in GLYPHS` is True, so an untitled window must not count on the glyph path.
        if any(owns_window(r, c) for r in open_recs) or (t[:1] and t[0] in GLYPHS):
            out.append(c)
    return out

# ---------- slugs ----------
STOP = set("""a an the and or of to for in on at by with from into over under as is are was be been being
this that these those it its my our your their his her you we i me us them via vs per about after before
during without within between across through up down out off than then so if when while where how what
which who whom whose""".split())
GENERIC = set("""add fix make update create build implement refactor review investigate debug migrate setup set
remove delete clean improve test write plan check run port wire ship handle support enable disable change
move rename use work try get allow ensure access finish complete project code issue task bug thing file
app page site repo branch commit error problem infrastructure infra feature config version system stuff
session chat new""".split())

def strip_glyph(title):
    t = title.strip()
    return t[1:].strip() if t[:1] in GLYPHS else t

def heuristic_slug(title):
    words = re.findall(r"[a-z0-9][a-z0-9.\-]*", strip_glyph(title).lower())
    keep = [w for w in words if w not in STOP and w not in GENERIC] or words[:2]
    if not keep: return ""
    two = " ".join(keep[:2])
    return two if len(two) <= 13 else keep[0][:10]

def slug(title, ai=True):
    """Heuristic now; a cached Haiku label if one exists; kick off Haiku in the background otherwise."""
    title = strip_glyph(title)
    if not title: return ""
    cache = load(SLUGS, {})
    if title in cache: return cache[title]
    if ai and not os.environ.get("AGENT_WS_NO_AI"):
        subprocess.Popen([sys.argv[0], "slug", "--ai", title], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    return heuristic_slug(title)

def ai_slug(title):
    cache = load(SLUGS, {})
    if title in cache: return cache[title]
    # One Haiku call per title, ever: a marker stops a second caller racing this one.
    mark = f"{STATE}/inflight/{hashlib.sha1(title.encode()).hexdigest()}"
    os.makedirs(os.path.dirname(mark), exist_ok=True)
    try:
        if time.time() - os.path.getmtime(mark) < 180: return ""
    except OSError: pass
    open(mark, "w").close()
    prompt = (
        "This is the title of a coding session running in one workspace of my desktop. "
        "Name that workspace so I can tell at a glance which session it is.\n\n"
        "Rules:\n"
        "- At most 13 characters. Lowercase. Letters, digits and hyphens only.\n"
        "- One or two words; a hyphen only inside a name that is really one word.\n"
        "- Name the thing worked on: the project, tool, file or feature. "
        "Never the verb, never the person.\n"
        "- Drop filler words: setup, question, issue, help, understanding, design, demo, "
        "project, app.\n"
        "- Keep proper nouns spelled as they are written in the title.\n\n"
        "Output only the name, nothing else.\n\nTitle: " + title)
    try:
        out = subprocess.run(["claude", "-p", "--model", "haiku", "--no-session-persistence",
                              "--strict-mcp-config", prompt],
                             capture_output=True, text=True, timeout=90,
                             env={**os.environ, "AGENT_WS_INTERNAL": "1"}).stdout.strip().splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return ""
    finally:
        try: os.remove(mark)
        except OSError: pass
    label = re.sub(r"[^a-z0-9 \-]", "", (out[0] if out else "").lower()).strip()
    if 0 < len(label) <= 14:
        def add(c):
            c[title] = label
            while len(c) > SLUG_CAP: c.pop(next(iter(c)))   # oldest first; insertion order kept
            return c
        with locked(SLUGS):
            c = add(load(SLUGS, {})); save(SLUGS, c, sort=False)
        return label
    return ""

# ---------- sessions ----------
def sessions(): return load(SESSIONS, {})

def resumable(transcript):
    """`claude --resume` needs a transcript on disk; an unused session leaves none."""
    try: return bool(transcript) and os.path.getsize(transcript) > 0
    except OSError: return False

def reopenable(rec):
    """Can this closed session be told to reopen? Claude is asked by its transcript, which
    has to still be on disk. The other two are asked by their session id alone, and Muse
    sends no transcript at all — measured, its payloads carry transcript_path: null — so
    testing every agent for a transcript threw every Muse session away the moment its
    window closed, and a named workspace could never bring one back."""
    row = AGENT_ROWS.get(rec.get("agent") or DEFAULT_AGENT)
    if row is None or not row.get("resume"): return False
    if "{transcript}" in " ".join(row["resume"]) or row["name"] == "claude":
        return resumable(rec.get("transcript", ""))
    return True

def remember(sid, **fields):
    def f(s):
        rec = s.get(sid, {}); rec.update(fields); s[sid] = rec; return s
    update(SESSIONS, f)

def forget(sid):
    update(SESSIONS, lambda s: (s.pop(sid, None), s)[1])

KEEP_DAYS = 30

def keepable(rec):
    """Keep anything its own agent could still reopen: the workspace may be unnamed now and
    named later, and then Super+Shift+A should still find it."""
    if rec.get("open"): return True
    if not reopenable(rec): return False
    return time.time() - rec.get("ended", 0) < KEEP_DAYS * 86400

def prune():
    update(SESSIONS, lambda s: {k: v for k, v in s.items() if keepable(v)})

WORK_TTL = 3600   # a session that says "working" and has fired no hook in an hour is not

def reap(now=None):
    """Close the sessions whose windows are gone, and cool down the ones that stopped
    saying anything.

    An agent killed with its terminal fires no session-end, so without this its record sat
    open — and, if it was mid-turn, working — for ever: a workspace on the bar spinning at
    nothing, and a resume that reopens a session nobody closed. The window is the real test;
    the hour is the backstop for a session that is alive but has gone quiet mid-turn (one
    long tool call fires no hook), where being wrong costs only a glyph.

    Runs only when Hyprland actually answered. "No windows" and "could not ask" must not be
    the same thing, or a single failed call retires every session on the machine."""
    cs = clients()
    if cs is None: return
    now = now or time.time()
    def f(s):
        hit = False
        for rec in s.values():
            if rec.get("open") and not any(owns_window(rec, c) for c in cs):
                rec.update(open=False, ended=now, state="idle", state_at=now); hit = True
            elif rec.get("state") == "working" and now - rec.get("state_at", 0) > WORK_TTL:
                rec.update(state="idle", state_at=now); hit = True
        return s if hit else None
    update(SESSIONS, f)

def needs_write(fn):
    def f(n):
        cut = time.time() - NEEDS_TTL
        n = {k: v for k, v in n.items()
             if (v.get("at", 0) if isinstance(v, dict) else v) > cut}
        return fn(n)
    return update(NEEDS, f)

def adopt_open_sessions(ws, name):
    """Naming a workspace claims its sessions — the open ones and anything that closed in
    it recently, so naming a workspace after the fact still brings those back."""
    def f(s):
        for rec in s.values():
            if rec.get("workspace") != ws: continue
            if rec.get("open") or time.time() - rec.get("ended", 0) < KEEP_DAYS * 86400:
                rec["name"] = name
        return s
    update(SESSIONS, f)

# ---------- hooks ----------
def adopt(sid, agent):
    """Name the agent of a session recorded before this version, and only then."""
    if not sid or not agent: return
    def f(s):
        rec = s.get(sid)
        if rec is None or rec.get("agent"): return None
        rec["agent"] = agent
        return s
    update(SESSIONS, f)

HEARTBEAT = 5     # how often a session already in this state bothers to say so again

def mark_state(sid, state, at, continuing=False):
    """Working or idle on a session we already know, at the moment the event reached us.

    Refused, in the same lock as every other write:
      · an event older than what is on record, because two hooks racing for this lock are
        handled in whichever order they get it, not the order they fired;
      · a continuation — a tool or a subagent finishing — waking an idle session;
      · working on a session whose window has closed.

    An event that only repeats the state already on record is a heartbeat, not a no-op: it
    moves the timestamp forward, at most every few seconds so the hot path still writes
    almost nothing. Without that the timestamp stayed at the moment work began, so a
    session working for longer than the hour the reaper allows was called idle while it was
    still firing tools, and a stop that fired before the newest prompt could still land."""
    if not sid or not state: return
    def f(s):
        rec = s.get(sid)
        if rec is None: return None
        if at <= rec.get("state_at", 0): return None
        same = rec.get("state") == state
        if not same and state == "working" and (continuing or not rec.get("open")): return None
        if same and at - rec.get("state_at", 0) < HEARTBEAT: return None
        rec["state"] = state; rec["state_at"] = at
        return s
    update(SESSIONS, f)

def clear_needs(sid):
    """Drop the needs-you flags this session raised, and only those. Clearing by window
    address instead let any other session sharing the window — a Claude started inside a
    Codex terminal — answer a permission prompt it never saw, by running one tool."""
    if not sid: return
    needs_write(lambda n: {k: v for k, v in n.items()
                           if not (isinstance(v, dict) and v.get("sid") == sid)})

def hook(event, agent=None):
    resolved = resolve_event(event)
    if resolved is None: return        # a name none of the three fires: silent no-op
    internal, spellers = resolved
    # Our own `claude -p` call for a slug fires hooks too, and owns no window.
    if os.environ.get("AGENT_WS_INTERNAL"): return
    now = time.time()                  # when this event reached us, taken before any lock wait
    try: data = json.load(sys.stdin) if not sys.stdin.isatty() else {}
    except ValueError: data = {}                 # a hook must never hand the agent a traceback
    if not isinstance(data, dict): data = {}
    if agent is not None:
        # The hook line lives in that agent's own config, so it says who fired it. No tree
        # walk for identity: the tree cannot tell an agent from the one it was launched in.
        row = AGENT_ROWS.get(agent)
        if row is None: return         # an agent we do not support: nothing to record it as
        args, i = tree_argv(row)       # only to tell a windowed run from a headless one
    else:
        # Wired by hand, with no --agent: the nearest agent above us is the one that fired
        # this hook. If it cannot have fired *this event*, we record nothing rather than
        # walk past it and file the session against some other agent's window.
        row, args, i = nearest_agent()
        if row is None:
            row = agent_from_payload(data, spellers)
            if row is None: return     # nobody we know called: an empty slot beats a wrong one
            args, i = [], -1
        elif row["name"] not in spellers: return
    if headless(row, args, i): return
    agent = row["name"]
    if is_helper(data): return         # a helper of the session, not the session itself
    norm = normalize(data, row)
    sid = norm["sid"]
    if internal == "session-start":
        reap(now)
        win = window_for_process()
        if not win or not sid: return
        ws = win["workspace"]["id"]
        prev = sessions().get(sid) or {}
        # Compaction and /clear fire session-start again on a session that never stopped.
        # That session keeps what it has: the transcript it is writing, and the state it is
        # in — a re-start used to push a working slot back to idle and blank the transcript.
        again = bool(prev.get("open")) and owns_window(prev, win)
        # A session is idle until it is given something to do. Every agent gets the field,
        # because only Claude spins a glyph into its title for the bar to read for free.
        remember(sid, agent=agent, cwd=norm["cwd"] or prev.get("cwd", ""), workspace=ws,
                 name=ws_name(ws), open=True, address=norm_addr(win["address"]),
                 pid=win["pid"], started=prev.get("started", now) if again else now,
                 transcript=norm["transcript"] or prev.get("transcript", ""),
                 state=prev.get("state", "idle") if again else "idle",
                 state_at=prev.get("state_at", now) if again else now)
    elif internal == "session-end":
        if not sid: return
        reap(now)
        # /exit is a deliberate end: forget. A closed window keeps the session resumable
        # as long as the agent left a transcript; prune() below drops it if not, and launch
        # re-checks, because the agent may still be flushing while this hook runs.
        tp = norm["transcript"] or sessions().get(sid, {}).get("transcript", "")
        if row["exiting"](event, data): forget(sid)
        elif sid in sessions(): remember(sid, agent=agent, open=False, ended=now,
                                         transcript=tp, state="idle", state_at=now)
        # A flag raised by this session dies with it: Hyprland hands the address straight to
        # the next window, which would otherwise inherit the loud mark.
        needs_write(lambda n: {k: v for k, v in n.items()
                               if not (isinstance(v, dict) and v.get("sid") == sid)})
        prune()
    elif internal == "notification":
        # Codex has no notification_type to read — PermissionRequest is the whole signal —
        # so each agent decides for itself what its payload means.
        if not sid or not row["needs"](event, data): return
        reap(now)
        win = window_for_process()
        if win:
            a = norm_addr(win["address"])
            needs_write(lambda n: {**n, a: {"at": now, "sid": sid}})
    elif internal in ("prompt-submit", "pre-tool", "stop"):
        # A session already running when this version was installed was recorded by the old
        # one, which knew of no agents, so it would show no mark until it was restarted.
        # Every line names its agent on every event, so the first one fills the gap in.
        adopt(sid, agent)
        mark_state(sid, STATE_OF[internal], now, canon(event) in CONTINUES)
        # The session moved, so whatever it was waiting for has been answered. Only its own
        # flags go: another session in the same window may still be waiting on you.
        if sid and load(NEEDS, {}): clear_needs(sid)   # the read is the cheap exit: fires per tool

# ---------- commands ----------
def cmd_name(sub, given=""):
    ws = focused_ws()
    if sub == "set":
        wins = session_windows(ws)
        suggested = ws_name(ws) or (slug(wins[0]["title"]) if wins else "")
        if given:                                # `agent-ws name set NAME`, no prompt
            name = re.sub(r'["\\]', "", given.strip())[:14]
        else:
            hint = f" (Enter = {suggested})" if suggested else ""
            r = subprocess.run(["omarchy", "menu", "input", f"Name workspace {ws}{hint}", "--width", "420"],
                               capture_output=True, text=True)
            if r.returncode != 0: return
            name = re.sub(r'["\\]', "", r.stdout.strip())[:14] or suggested
        if not set_name(ws, name): return
        if name:
            adopt_open_sessions(ws, name)
            dispatch(f'hl.dsp.workspace.rename({{ workspace = {ws}, name = "{name}" }})')
    elif sub == "clear":
        if not set_name(ws, ""): return
        # Forget only this workspace's closed sessions. Two workspaces can share a name, and
        # an open session belongs to its window, not to the label.
        update(SESSIONS, lambda s: {k: v for k, v in s.items()
                                    if v.get("open") or v.get("workspace") != ws})
        dispatch(f'hl.dsp.workspace.rename({{ workspace = {ws}, name = "{ws}" }})')
    elif sub == "apply":
        # At login a named workspace may not exist yet — whatever runs there is still
        # starting — so keep looking for the ones still missing for a minute.
        want = {k: v for k, v in config().items()
                if k.isdigit() and isinstance(v, str) and v.strip()}
        for _ in range(13):
            live = {str(w["id"]) for w in (hypr("workspaces") or [])}
            for k in [k for k in want if k in live]:
                dispatch(f'hl.dsp.workspace.rename({{ workspace = {k}, name = "{want.pop(k)}" }})')
            if not want: break
            time.sleep(5)
    elif sub == "list":
        print(json.dumps(config(), indent=2))

SETTINGS = f"{HOME}/.config/omarchy/agent-workspaces.json"

def launch_command():
    """What Super+Shift+A runs. Plain `claude` unless you say otherwise in
    ~/.config/omarchy/agent-workspaces.json, e.g.
        {"launch": ["claude", "--dangerously-skip-permissions"], "cwd": "~/code"}"""
    cfg = load(SETTINGS, {})
    cmd = cfg.get("launch") or ["claude"]
    if not isinstance(cmd, list) or not all(isinstance(c, str) for c in cmd): cmd = ["claude"]
    return cmd, os.path.expanduser(str(cfg.get("cwd") or ""))

# Session-scoped vars Claude Code exports to its children. Inheriting them makes the
# new window a *child* session, which never writes a transcript and so can never be
# resumed. Strip them so a session launched from inside Claude is a real one.
CHILD_ENV = ("CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_ENTRYPOINT",
             "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
             "CLAUDE_CODE_BRIDGE_SESSION_ID", "CLAUDE_CODE_EXECPATH", "CLAUDE_PID",
             "CLAUDE_EFFORT", "CLAUDECODE", "AI_AGENT")

def resume_args(row, sid):
    """How this agent is told to reopen a session, or None for one that cannot be told.
    None means we open it fresh instead of a terminal that dies on startup."""
    tpl = row.get("resume") or ()
    return [p.format(sid=sid) for p in tpl] if tpl and sid else None

def launch_agent(row, cwd, *args):
    """Open a terminal running one agent. The launch override in agent-workspaces.json is a
    command line, so it belongs to the default agent only: a Codex session must not be
    reopened by whatever the user set `claude` to."""
    env = {k: v for k, v in os.environ.items() if k not in CHILD_ENV}
    cmd, home_cwd = launch_command()
    if row["name"] != DEFAULT_AGENT: cmd = list(row["cmd"])
    cwd = cwd if os.path.isdir(cwd) else home_cwd
    subprocess.Popen(["omarchy-launch-tui", "--app-id=org.omarchy.agent", *cmd, *args],
                     cwd=cwd if os.path.isdir(cwd) else None, start_new_session=True, env=env,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def workspace_belongings(ws):
    """What a reset of `ws` would take: its name, the session records that belong to it, and
    the windows to close. A window is only ours if a session record points at it — a glyph in
    a title is enough to *show* a session, but not enough to close somebody's window."""
    live = {norm_addr(c["address"]): c for c in (clients() or [])}
    here, elsewhere = {}, set()
    for sid, r in sessions().items():
        a = norm_addr(r.get("address", ""))
        win = live.get(a)
        if win is not None and win["workspace"]["id"] == ws: here[sid] = win
        elif win is not None: elsewhere.add(sid)
    # Closed records that started here and have no window anywhere are this workspace's too.
    forget = set(here) | {sid for sid, r in sessions().items()
                          if sid not in here and sid not in elsewhere and r.get("workspace") == ws}
    return ws_name(ws), forget, list(here.values())

def reset_workspace(ws):
    """Bare number again: no name, no remembered sessions, no marks, no windows of ours."""
    _, forget, wins = workspace_belongings(ws)
    if set_name(ws, "") is False: return None
    update(SESSIONS, lambda s: {k: v for k, v in s.items() if k not in forget})
    gone = {norm_addr(w["address"]) for w in wins}
    needs_write(lambda n: {k: v for k, v in n.items() if norm_addr(k) not in gone})
    dispatch(f'hl.dsp.workspace.rename({{ workspace = {ws}, name = "{ws}" }})')
    for w in wins:
        dispatch(f'hl.dsp.window.close({{ window = "address:{w["address"]}" }})')
    return len(wins)

def cmd_reset(args):
    every = "--all" in args
    targets = sorted({w["id"] for w in (hypr("workspaces") or []) if w["id"] > 0}) \
              if every else [focused_ws()]
    if not targets: return
    names, forget, wins = set(), set(), 0
    for w in targets:
        n, f, ws_wins = workspace_belongings(w)
        if n: names.add(n)
        forget |= f; wins += len(ws_wins)
    if not (names or forget or wins):
        notify("Nothing to reset", f"workspace {targets[0]}" if not every else "")
        return
    # Ask whenever anything would be lost, not only when a window would close: a workspace
    # whose sessions are all closed is exactly the one whose memory is worth keeping.
    if "--force" not in args:
        lost = []
        if names: lost.append("the name" if len(names) == 1 else f"{len(names)} names")
        if forget: lost.append(f"{len(forget)} remembered session" + ("s" if len(forget) != 1 else ""))
        if wins: lost.append(f"{wins} open window" + ("s" if wins != 1 else ""))
        what = "every workspace" if every else f"workspace {targets[0]}"
        try:
            r = subprocess.run(["omarchy", "menu", "select",
                                f"Reset {what}? This loses " + ", ".join(lost), "Cancel", "Reset"],
                               capture_output=True, text=True)
        except OSError:
            notify("Reset cancelled", "the omarchy menu is not available")
            return
        if r.returncode != 0 or r.stdout.strip() != "Reset": return
    for w in targets: reset_workspace(w)
    notify("Workspace reset", "every workspace" if every else f"workspace {targets[0]}")

def cmd_launch():
    reap()          # a window closed without a session-end is a session to bring back, not one to leave open
    ws = focused_ws(); name = ws_name(ws)
    closed = [(sid, r) for sid, r in sessions().items()
              if name and r.get("name") == name and not r.get("open")] if name else []
    # Two things stop a session being resumed: its transcript vanished between close and
    # now, or its agent has no way to be told to reopen one. Neither is a reason to lose the
    # workspace — those open fresh where they were working, instead of a terminal that dies
    # on "No conversation found", or a Codex session opened as `claude --resume <codex id>`.
    gone = {sid for sid, r in closed if not reopenable(r)}
    resumed = fresh = 0
    for sid, r in sorted(closed, key=lambda x: x[1].get("ended", 0)):
        row = AGENT_ROWS.get(r.get("agent") or DEFAULT_AGENT)
        if row is None: continue     # a record naming an agent this version does not know
        args = None if sid in gone else resume_args(row, sid)
        launch_agent(row, r.get("cwd", ""), *(args or ()))
        if args: resumed += 1
        else: fresh += 1
    if gone: update(SESSIONS, lambda s: {k: v for k, v in s.items() if k not in gone})
    if resumed or fresh:
        what = [f"{resumed} resumed"] if resumed else []
        if fresh: what.append(f"{fresh} fresh")
        notify("Restoring sessions", ", ".join(what) + f" in {name}")
    else:
        launch_agent(AGENT_ROWS[DEFAULT_AGENT], "")

def parse_hook_args(args):
    """`hook EVENT [--agent NAME] [--state DIR]`, in any order and with either spelling of
    a value, because these lines are written into three agents' configs by hand as often as
    not."""
    event, agent, state, i = "", None, None, 0
    while i < len(args):
        t = args[i]
        if t.startswith("--agent="): agent = t.split("=", 1)[1]
        elif t == "--agent" and i + 1 < len(args): agent = args[i + 1]; i += 1
        elif t.startswith("--state="): state = t.split("=", 1)[1]
        elif t == "--state" and i + 1 < len(args): state = args[i + 1]; i += 1
        elif not event and not t.startswith("-"): event = t
        i += 1
    return event, (agent or "").strip().lower() or None, (state or "").strip() or None

def use_state(path):
    """Point every state file at another folder.

    Muse hands its hooks almost no environment, XDG_STATE_HOME among the things it drops,
    so a hook would write to the default folder while a bar told to use another one read
    somewhere else and saw nothing. The installer resolves the folder once and writes it
    into the line, which is the only place that knows both sides."""
    global STATE, SESSIONS, NEEDS, SLUGS
    STATE = path
    SESSIONS, NEEDS, SLUGS = (f"{STATE}/{n}.json" for n in ("sessions", "needs", "slugs"))

def main():
    a = sys.argv[1:]
    if not a: print(__doc__); sys.exit(1)
    if a[0] == "hook" and len(a) > 1:
        event, agent, state = parse_hook_args(a[1:])
        if state: use_state(state)
        if event: hook(event, agent)
    elif a[0] == "name" and len(a) > 1: cmd_name(a[1], " ".join(a[2:]))
    elif a[0] == "launch": cmd_launch()
    elif a[0] == "reset": cmd_reset(a[1:])
    elif a[0] == "slug" and len(a) > 1:
        if a[1] == "--ai": print(ai_slug(" ".join(a[2:])))
        else: print(slug(" ".join(a[1:])))
    elif a[0] == "log":
        os.makedirs(STATE, exist_ok=True)
        path = f"{STATE}/debug.log"
        try:
            if os.path.getsize(path) > LOG_CAP: os.replace(path, path + ".1")
        except OSError: pass
        with open(path, "a") as f:
            f.write(time.strftime("%H:%M:%S ") + " ".join(a[1:]) + "\n")
    elif a[0] == "state":
        reap()          # the dump is for debugging: show what is true now, not what was left behind
        print(json.dumps({"config": config(), "sessions": sessions(), "needs": load(NEEDS, {}),
                          "slugs": load(SLUGS, {})}, indent=2))
    else: print(__doc__); sys.exit(1)

if __name__ == "__main__": main()
